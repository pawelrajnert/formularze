# LLM po API Mistral (domyślnie) albo lokalna Ollama: LLM_BASE_URL=http://ollama:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=ministral-3:14b
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=ministral-14b-latest
# R-04: kilka kluczy tego samego dostawcy -> LLM_API_KEY=klucz1,klucz2 (każdy ma własny limit zapytań)
# R-04: model zapasowy na tym samym endpoincie, gdy główny ma pełny limit (Mistral free: 2 zapytania/min na model)
LLM_FALLBACK_MODELS=ministral-8b-latest
# R-07: ile sekund najwyżej czekać na wolny główny model, zanim szkic zrobi zapasowy (jakość dużych formularzy)
LLM_FALLBACK_MAX_WAIT=20
# R-04: pamięć podręczna szkiców (ten sam plik + model + prompt -> wynik bez LLM); 0 = wyłączona
DRAFT_CACHE_SIZE=32
# albo model z rejestru config/models.yaml (pierwszeństwo przed LLM_*; per żądanie: ?model=<id>)
LLM_MODEL_ID=
OCR_LANG=pol
MAX_FILE_SIZE_MB=20
AUTH_ENABLED=true
AUTH_USER=admin
AUTH_PASSWORD=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# S-02: maskowanie PII przed LLM + oznaczenie treści AI (art. 50 AI Act) w ai_disclosure; false = tryb jury
COMPLIANCE_ENABLED=false
# F-18: bez zatwierdzenia urzędnika eksport JSON zablokowany; rekordy w AUDIT_DIR. false = tryb jury
APPROVAL_REQUIRED=false
AUDIT_DIR=audit
# S-01: limit zapytań na IP i endpoint (/auth/token, /forms/convert), 0 = wyłączony
RATE_LIMIT_PER_MINUTE=30
